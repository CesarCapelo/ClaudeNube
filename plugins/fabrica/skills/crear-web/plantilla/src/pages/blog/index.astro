---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sitio } from '../../config/sitio';

const articulos = (await getCollection('blog', ({ data }) => !data.borrador)).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);
const formatoFecha = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' });
---

<Base titulo="Blog" descripcion={`Artículos y novedades de ${sitio.nombre}.`}>
  <section class="contenedor py-16 md:py-24">
    <h1 class="text-4xl font-bold md:text-5xl">Blog</h1>
    {articulos.length === 0 ? (
      <p class="mt-6 text-lg text-tinta-suave">Pronto publicaremos los primeros artículos.</p>
    ) : (
      <ul class="mt-12 grid gap-8 md:grid-cols-2">
        {articulos.map((articulo) => (
          <li class="rounded-[var(--radius-tarjeta)] border border-borde bg-white p-7">
            <time datetime={articulo.data.fecha.toISOString()} class="text-sm text-tinta-suave">
              {formatoFecha.format(articulo.data.fecha)}
            </time>
            <h2 class="mt-2 text-xl font-semibold">
              <a href={`/blog/${articulo.id}`} class="hover:text-marca-800">
                {articulo.data.titulo}
              </a>
            </h2>
            <p class="mt-2 text-tinta-suave">{articulo.data.descripcion}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
