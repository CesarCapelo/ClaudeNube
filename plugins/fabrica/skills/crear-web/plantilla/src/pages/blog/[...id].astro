---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sitio } from '../../config/sitio';

export async function getStaticPaths() {
  const articulos = await getCollection('blog', ({ data }) => !data.borrador);
  return articulos.map((articulo) => ({ params: { id: articulo.id }, props: { articulo } }));
}

const { articulo } = Astro.props;
const { Content } = await render(articulo);
const formatoFecha = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: articulo.data.titulo,
    description: articulo.data.descripcion,
    datePublished: articulo.data.fecha.toISOString(),
    dateModified: (articulo.data.actualizado ?? articulo.data.fecha).toISOString(),
    author: { '@type': 'Organization', name: sitio.nombre },
    publisher: { '@type': 'Organization', name: sitio.nombre },
  },
];
---

<Base titulo={articulo.data.titulo} descripcion={articulo.data.descripcion} jsonLd={jsonLd}>
  <article class="contenedor py-16 md:py-24">
    <a href="/blog" class="text-marca-700 hover:text-marca-900">
      ← Volver al blog
    </a>
    <h1 class="mt-6 max-w-3xl text-4xl font-bold md:text-5xl">{articulo.data.titulo}</h1>
    <p class="mt-4 text-tinta-suave">
      <time datetime={articulo.data.fecha.toISOString()}>
        {formatoFecha.format(articulo.data.fecha)}
      </time>
    </p>
    <div class="prosa-legal mt-10">
      <Content />
    </div>
  </article>
</Base>
