---
import Base from '../layouts/Base.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import MapaDiferido from '../components/MapaDiferido.astro';
import Icono from '../components/Icono.astro';
import { sitio, direccionEnUnaLinea, telefonoEnlace } from '../config/sitio';
---

<Base
  titulo="Contacto"
  descripcion={`Contacta con ${sitio.nombre}: teléfono, correo, dirección y formulario. Te respondemos lo antes posible.`}
>
  <section class="contenedor grid gap-14 py-16 md:grid-cols-2 md:py-24">
    <div>
      <h1 class="text-4xl font-bold md:text-5xl">Contacto</h1>
      <p class="mt-4 text-lg text-tinta-suave">
        Cuéntanos qué necesitas y te respondemos lo antes posible.
      </p>
      <ul class="mt-10 space-y-5 text-lg">
        <li class="flex items-center gap-4">
          <Icono nombre="Phone" class="size-6 text-marca-700" />
          <a href={telefonoEnlace} class="hover:text-marca-800">
            {sitio.contacto.telefono}
          </a>
        </li>
        <li class="flex items-center gap-4">
          <Icono nombre="Mail" class="size-6 text-marca-700" />
          <a href={`mailto:${sitio.contacto.email}`} class="hover:text-marca-800">
            {sitio.contacto.email}
          </a>
        </li>
        {direccionEnUnaLinea && (
          <li class="flex items-center gap-4">
            <Icono nombre="MapPin" class="size-6 text-marca-700" />
            <span>{direccionEnUnaLinea}</span>
          </li>
        )}
      </ul>
      {direccionEnUnaLinea && (
        <div class="mt-10">
          <MapaDiferido />
        </div>
      )}
    </div>
    <div class="rounded-[var(--radius-tarjeta)] border border-borde bg-white p-6 md:p-10">
      <h2 class="text-2xl font-bold">Escríbenos</h2>
      <div class="mt-6">
        <FormularioContacto />
      </div>
    </div>
  </section>
</Base>
