# Copia este fichero a .env.local para desarrollo (la skill lo hace con valores generados).
# En producción, estas variables se configuran en el proveedor de alojamiento, nunca en el repositorio.

# Base de datos: postgres://usuario:clave@host:5432/base (producción) o pglite://.datos/desarrollo (local)
DATABASE_URL=pglite://.datos/desarrollo

# Secreto de sesiones: genera uno con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# URL pública de la aplicación
BETTER_AUTH_URL=http://localhost:3000

# true = cualquiera puede registrarse (SaaS). Vacío = solo la primera cuenta; el resto las crea la administración.
REGISTRO_ABIERTO=
