---
import Base from '../layouts/Base.astro';
import Boton from '../components/Boton.astro';
import Icono from '../components/Icono.astro';
import HuecoFoto from '../components/HuecoFoto.astro';
import Preguntas from '../components/Preguntas.astro';
import { faqJsonLd, type Pregunta } from '../lib/faq';
import { servicios } from '../config/servicios';
import { sitio, direccionEnUnaLinea, telefonoEnlace, whatsappEnlace } from '../config/sitio';

const pasos = [
  'Empiezo escuchándote: qué te pasa, desde cuándo y cómo te afecta en el día a día.',
  'Valoro tu movimiento y la zona que te preocupa.',
  'Trabajo con las manos y con ejercicio, sin dejarte esperando mientras una máquina hace el trabajo.',
  'Te explico lo que encuentro y te llevas pautas claras para casa.',
];

const diferenciadores = [
  { icono: 'Timer', titulo: '50 minutos', texto: 'Cada sesión dura 50 minutos, sin prisas.' },
  {
    icono: 'UserRound',
    titulo: 'Siempre conmigo',
    texto: 'No pasas de mano en mano ni repites tu historia.',
  },
  {
    icono: 'Hand',
    titulo: 'Un solo paciente a la vez',
    texto: 'Sesiones individuales: ese tiempo es solo tuyo.',
  },
] as const;

const horario = sitio.horario.map((h) => `${h.dias}, ${h.horas}`).join('; ');

const preguntas: Pregunta[] = [
  {
    pregunta: '¿Cuánto dura una sesión?',
    respuesta: 'Cada sesión es individual y dura 50 minutos.',
  },
  {
    pregunta: '¿Me atenderá siempre la misma persona?',
    respuesta: 'Sí. Te atiende siempre la misma fisioterapeuta en todas las sesiones.',
  },
  {
    pregunta: '¿Cómo pido cita?',
    respuesta: `Por WhatsApp o por teléfono en el ${sitio.contacto.telefono}, o con el formulario de contacto. Mi horario es: ${horario}.`,
  },
  {
    pregunta: '¿Necesito una derivación del médico?',
    respuesta:
      'Para venir a una consulta privada no suele hacer falta. Si tu seguro o tu mutua la exige, consúltalo con ellos antes de reservar.',
  },
  {
    pregunta: '¿Qué llevo a la primera sesión?',
    respuesta:
      'Ropa cómoda y, si los tienes, informes o pruebas médicas relacionados con lo que te ocurre.',
  },
];
---

<Base
  titulo="Fisioterapia en Getafe (Sector III)"
  descripcion={sitio.descripcion}
  jsonLd={[faqJsonLd(preguntas)]}
>
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(60rem_30rem_at_80%_-10%,var(--color-marca-100),transparent)]"
      aria-hidden="true"
    ></div>
    <div class="contenedor grid items-center gap-12 py-14 md:grid-cols-[1.15fr_1fr] md:py-28">
      <div>
        <p class="font-semibold text-marca-700">Fisioterapia en Getafe · Sector III</p>
        <h1 class="mt-4 text-4xl leading-[1.1] font-bold md:text-6xl">
          Fisioterapia en Getafe, con tiempo y con la misma fisioterapeuta
        </h1>
        <p class="mt-6 max-w-xl text-lg text-tinta-suave md:text-xl">
          Sesiones individuales de 50 minutos, con manos y ejercicio, sin máquinas de «enchufar y
          esperar». Para corredores, para mujeres en embarazo y posparto y para quien convive con
          dolor de espalda o cuello.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          {whatsappEnlace && (
            <Boton href={whatsappEnlace} externo>
              Pedir cita por WhatsApp
            </Boton>
          )}
          <Boton href={telefonoEnlace} variante="secundario">
            <Icono nombre="Phone" class="size-5" />
            Llamar
          </Boton>
        </div>
      </div>
      <HuecoFoto descripcion="la clínica o Lucía" class="aspect-[4/3] md:aspect-[4/5]" />
    </div>
  </section>

  <section class="contenedor py-16 md:py-24" aria-labelledby="titulo-servicios">
    <h2 id="titulo-servicios" class="text-3xl font-bold md:text-4xl">
      Tres formas de ayudarte
    </h2>
    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {servicios.map((s) => (
        <li class="flex">
          <a
            href={s.ruta}
            class="group flex w-full flex-col rounded-[var(--radius-tarjeta)] border border-borde bg-white p-7 transition-colors hover:border-marca-300 hover:bg-marca-50"
          >
            <span class="inline-flex size-12 items-center justify-center rounded-xl bg-marca-50 text-marca-700 group-hover:bg-white">
              <Icono nombre={s.icono} class="size-6" />
            </span>
            <h3 class="mt-5 text-xl font-semibold">{s.nombre}</h3>
            <p class="mt-2 flex-1 text-tinta-suave">{s.resumen}</p>
            <span class="mt-5 font-semibold text-marca-800">Ver {s.nombre.toLowerCase()} →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-superficie py-16 md:py-24" aria-labelledby="titulo-como">
    <div class="contenedor grid gap-12 md:grid-cols-[1fr_1.3fr]">
      <div>
        <h2 id="titulo-como" class="text-3xl font-bold md:text-4xl">
          Una sesión pensada para ti
        </h2>
        <ul class="mt-8 space-y-5">
          {diferenciadores.map((d) => (
            <li class="flex items-start gap-4">
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-marca-700 text-white">
                <Icono nombre={d.icono} class="size-5" />
              </span>
              <div>
                <p class="font-semibold">{d.titulo}</p>
                <p class="text-tinta-suave">{d.texto}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <ol class="space-y-6">
        {pasos.map((texto, i) => (
          <li class="flex gap-5">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-white font-display text-lg font-bold text-marca-800 ring-1 ring-marca-200">
              {i + 1}
            </span>
            <p class="pt-2 text-lg">{texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="contenedor py-16 md:py-24" aria-labelledby="titulo-donde">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div>
        <h2 id="titulo-donde" class="text-3xl font-bold md:text-4xl">
          En el Sector III de Getafe
        </h2>
        <p class="mt-4 text-lg text-tinta-suave">La clínica está en {direccionEnUnaLinea}.</p>
        <p class="mt-2 text-lg text-tinta-suave">{horario}.</p>
        <div class="mt-8">
          <Boton href="/contacto" variante="secundario">
            Cómo llegar y contacto
          </Boton>
        </div>
      </div>
      <HuecoFoto descripcion="la entrada o la sala de espera" icono="MapPin" variante="b" />
    </div>
  </section>

  <Preguntas preguntas={preguntas} />

  <section class="contenedor pb-8" aria-labelledby="titulo-cta">
    <div class="rounded-[var(--radius-tarjeta)] bg-marca-900 px-8 py-14 text-center text-white md:px-16">
      <h2 id="titulo-cta" class="text-3xl font-bold md:text-4xl">
        Cuéntame qué te pasa
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-marca-100">
        Escríbeme y buscamos un hueco que te vaya bien.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        {whatsappEnlace && (
          <Boton href={whatsappEnlace} externo variante="acento">
            Pedir cita por WhatsApp
          </Boton>
        )}
        <Boton href={telefonoEnlace} variante="secundario">
          <Icono nombre="Phone" class="size-5" />
          Llamar al {sitio.contacto.telefono}
        </Boton>
      </div>
    </div>
  </section>
</Base>
