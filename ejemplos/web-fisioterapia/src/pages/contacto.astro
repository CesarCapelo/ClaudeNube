---
import Base from '../layouts/Base.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import MapaDiferido from '../components/MapaDiferido.astro';
import Icono from '../components/Icono.astro';
import Boton from '../components/Boton.astro';
import { sitio, direccionEnUnaLinea, telefonoEnlace, whatsappEnlace } from '../config/sitio';
---

<Base
  titulo="Pedir cita en Getafe"
  sinWhatsApp
  descripcion={`Pide cita en ${sitio.nombre} (Getafe, Sector III) por WhatsApp, teléfono, correo o formulario. Lunes a viernes.`}
>
  <section class="contenedor grid gap-14 py-16 md:grid-cols-2 md:py-24">
    <div>
      <h1 class="text-4xl font-bold md:text-5xl">Pide tu cita</h1>
      <p class="mt-4 text-lg text-tinta-suave">
        Escríbeme por WhatsApp o llámame y buscamos un hueco. También puedes usar el formulario, que
        no es para urgencias ni para contar tus síntomas con detalle: eso lo vemos en la sesión.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {whatsappEnlace && (
          <Boton href={whatsappEnlace} externo>
            Escribir por WhatsApp
          </Boton>
        )}
        <Boton href={telefonoEnlace} variante="secundario">
          <Icono nombre="Phone" class="size-5" />
          Llamar
        </Boton>
      </div>
      <ul class="mt-10 space-y-5 text-lg">
        <li class="flex items-center gap-4">
          <Icono nombre="Phone" class="size-6 text-marca-700" />
          <a href={telefonoEnlace} class="hover:text-marca-800">
            {sitio.contacto.telefono}
          </a>
        </li>
        <li class="flex items-center gap-4">
          <Icono nombre="Mail" class="size-6 text-marca-700" />
          <a href={`mailto:${sitio.contacto.email}`} class="hover:text-marca-800">
            {sitio.contacto.email}
          </a>
        </li>
        {direccionEnUnaLinea && (
          <li class="flex items-center gap-4">
            <Icono nombre="MapPin" class="size-6 text-marca-700" />
            <span>{direccionEnUnaLinea}</span>
          </li>
        )}
        {sitio.horario.map((h) => (
          <li class="flex items-center gap-4">
            <Icono nombre="Clock" class="size-6 text-marca-700" />
            <span>
              {h.dias}:{' '}
              {h.horas.split(' y ').map((tramo, i) => (
                <>
                  {i > 0 && ' y '}
                  <span class="whitespace-nowrap">{tramo}</span>
                </>
              ))}
            </span>
          </li>
        ))}
      </ul>
      {direccionEnUnaLinea && (
        <div class="mt-10">
          <MapaDiferido />
        </div>
      )}
    </div>
    <div class="rounded-[var(--radius-tarjeta)] border border-borde bg-white p-6 md:p-10">
      <h2 class="text-2xl font-bold">Escríbeme</h2>
      <div class="mt-6">
        <FormularioContacto />
      </div>
    </div>
  </section>
</Base>
