---
import Base from './Base.astro';
import { sitio } from '../config/sitio';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
const fecha = new Date(`${sitio.legal.actualizacion}T00:00:00`).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base titulo={titulo} descripcion={descripcion} sinWhatsApp>
  <article class="contenedor py-16 md:py-24">
    <h1 class="text-3xl font-bold md:text-4xl">{titulo}</h1>
    <p class="mt-3 text-tinta-suave">Última actualización: {fecha}</p>
    <div class="prosa-legal mt-10">
      <slot />
    </div>
  </article>
</Base>
